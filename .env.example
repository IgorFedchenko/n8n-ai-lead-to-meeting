# ./scripts/demo.sh creates random LOCAL secrets on the host. No real credentials required.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
SERVICE_KEY=
WEBHOOK_TOKEN=
INTEGRATION_MODE=mock
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Only for another provider implementing OpenAI's structured-output HTTP contract.
LLM_BASE_URL=
MOCK_URL=http://mock:8001
RETRY_DELAY_SCALE=1
DEMO_PORT=8088
N8N_PORT=5679
PUBLIC_DEMO_URL=http://localhost:8088
RETENTION_DAYS=7

# Live mode is operator-configured. LLM use and API keys require owner's approval first.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=demo@example.test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Conservative configured-rate LLM admission; mock mode always reserves synthetic zero.
LLM_SPEND_APPROVED=false
LLM_MAX_ATTEMPTS=6
LLM_MAX_INPUT_BYTES=20000
LLM_MAX_OUTPUT_TOKENS=900
# USD per million tokens, positive explicit operator rates; blank makes live fail closed.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_RUN_BUDGET_USD=
LLM_RATE_SOURCE=
HUBSPOT_CURRENCY=USD
SMTP_RESERVATION_SECONDS=120
# Optional local Phoenix: start --profile observability, then opt in and recreate app.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://phoenix:6006/v1/traces
