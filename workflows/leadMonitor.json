{
  "id": "leadMonitor",
  "name": "05 \u00b7 Detect stalled runs, retry alerts, prune private data",
  "active": false,
  "nodes": [
    {
      "id": "677c8776-f7fc-5dad-bafd-56e2358e1613",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "10b77a34-509d-5ccf-9aca-132fcab6fada",
      "name": "Check runs and retry alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://app:8000/api/monitor",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{ $env.SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "a383c3cd-d193-504d-98ae-6814a1a6a350",
      "name": "Apply retention policy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://app:8000/api/maintenance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{ $env.SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Check runs and retry alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check runs and retry alerts": {
      "main": [
        [
          {
            "node": "Apply retention policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "executionTimeout": 600,
    "errorWorkflow": "leadErrors"
  },
  "pinData": {},
  "tags": []
}
