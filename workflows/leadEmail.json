      "id": "b6087b71-91a7-5cea-b361-d628b8000717",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        300
      ],
      "parameters": {
        "jsCode": "const m = $json;\nconst from = typeof m.from === 'string' ? m.from : (m.from?.text || '');\nconst email = (from.match(/<([^>]+)>/) || from.match(/([^\\s<>]+@[^\\s<>]+)/) || [])[1];\nconst requestId = m.messageId || m.metadata?.['message-id'];\nif (!requestId || !email) throw new Error('Email requires Message-ID and a sender address');\nreturn [{json: {lead: {request_id: String(requestId).replace(/[<>]/g, ''), source: 'email',\nname: from.replace(/<[^>]+>/g, '').trim() || email, email, phone: '',\nmessage: String(m.textPlain || m.text || '').trim()}, execution_id: $execution.id}}];"
      }
    },
    {
      "id": "cfd91f00-5f2e-55c3-b61a-606b9d9dd6e7",
      "name": "Accept and deduplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://app:8000/api/intake",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{ $env.SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
